{
  "expo": {
    "name": "WAYA",
    "slug": "waya-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "waya",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "WAYA utilise l'appareil photo pour attacher un moment a ta trace.",
        "NSPhotoLibraryUsageDescription": "WAYA peut choisir une photo ou une video pour accompagner ta trace."
      }
    },
    "android": {
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-image-picker"
    ]
  }
}
